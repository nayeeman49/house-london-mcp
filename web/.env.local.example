# Path to house-london-mcp project root (parent of web/)
HOUSING_PROJECT_ROOT=/Users/user/Documents/Projects/house-london-mcp

# Python MCP server
MCP_PYTHON=/Users/user/Documents/Projects/house-london-mcp/venv/bin/python
MCP_SERVER=/Users/user/Documents/Projects/house-london-mcp/src/server.py

# Copy from operation-front-row/.env.local or paste your key here
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# false = GPT dynamic chat with live MCP context each message
# true  = MCP-only scripted replies (no OpenAI charges)
USE_MCP_ONLY=false

# Mapbox basemap for /map (required for the interactive map)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional — reserved for photorealistic Google 3D tiles (not used for metric colouring)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
